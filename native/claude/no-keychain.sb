(version 1)

;; AIM's managed Claude boundary is deliberately allow-default: Claude keeps
;; its ordinary local project/tool/network behavior, while global Claude state
;; and other AIM labels stay closed.
(allow default)

;; The verified official client invokes bare `security` for its credential
;; store, so AIM's compatibility executable is first on PATH and supplies the
;; file-fallback semantics. Do not deny macOS credential or trust services for
;; the whole process tree: ordinary descendants such as gh and Codex need them.

;; The caller's global Claude state is never part of a managed label. Personal
;; skills and installed plugin packages are read-only exceptions. Exact
;; user-configured hook/MCP roots are inserted at launch so trusted
;; customizations retain their normal state without opening unrelated state.
(deny file-write*
    (require-all
        (subpath (string-append (param "USER_HOME") "/.claude"))
        (require-not
            (require-any
                (literal "/.aimgr-no-user-customizations")
                ;; AIM_USER_CUSTOMIZATION_ACCESS_EXCEPTIONS
            )))
    (literal (string-append (param "USER_HOME") "/.claude.json"))
    (require-all
        (subpath (string-append (param "USER_HOME_ALIAS") "/.claude"))
        (require-not
            (require-any
                (literal "/.aimgr-no-user-customizations")
                ;; AIM_USER_CUSTOMIZATION_ACCESS_EXCEPTIONS
            )))
    (literal (string-append (param "USER_HOME_ALIAS") "/.claude.json")))
(deny file-read* file-test-existence
    (require-all
        (subpath (string-append (param "USER_HOME") "/.claude"))
        (require-not
            (require-any
                (subpath (string-append (param "USER_HOME") "/.claude/skills"))
                (subpath (string-append (param "USER_HOME") "/.claude/plugins/cache"))
                (literal "/.aimgr-no-user-customizations")
                ;; AIM_USER_CUSTOMIZATION_ACCESS_EXCEPTIONS
            )))
    (literal (string-append (param "USER_HOME") "/.claude.json"))
    (require-all
        (subpath (string-append (param "USER_HOME_ALIAS") "/.claude"))
        (require-not
            (require-any
                (subpath (string-append (param "USER_HOME_ALIAS") "/.claude/skills"))
                (subpath (string-append (param "USER_HOME_ALIAS") "/.claude/plugins/cache"))
                (literal "/.aimgr-no-user-customizations")
                ;; AIM_USER_CUSTOMIZATION_ACCESS_EXCEPTIONS
            )))
    (literal (string-append (param "USER_HOME_ALIAS") "/.claude.json")))

;; No AIM state except this label's home and the reviewed runtime helper is
;; reachable. This closes every other label without generating a policy.
(deny file-read* file-test-existence file-write*
    (require-all
        (subpath (param "AIMGR_ROOT"))
        (require-not
            (require-any
                (subpath (param "SELECTED_LABEL_HOME"))
                (subpath (param "ADAPTER_RUNTIME_ROOT"))))))

;; Cover both the caller-facing and filesystem-canonical paths so following the
;; label symlink never turns the shared skill tree into a writable surface.
(deny file-write*
    (subpath (string-append (param "USER_HOME") "/.claude/skills"))
    (subpath (string-append (param "USER_HOME_ALIAS") "/.claude/skills"))
    (subpath (string-append (param "LAUNCH_HOME") "/.claude/skills"))
    (subpath (string-append (param "LAUNCH_HOME_ALIAS") "/.claude/skills")))
